{
  "name": "amortentia",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm -r dev",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "npm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "npm run seed:mvp -w @amortentia/backend",
    "backend:dev": "npm run dev -w @amortentia/backend",
    "storefront:dev": "npm run dev -w @amortentia/storefront",
    "build:gelato-client": "npm run build -w @amortentia/gelato-client"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    }
  },
  "devDependencies": {
    "turbo": "^2.0.14",
    "prettier": "^3.2.5"
  },
  "workspaces": [
    "apps/**",
    "packages/*",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "ajv": "^8.0.0"
  }
}
